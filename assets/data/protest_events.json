ps://events.pol-rev.com/media/08128a9f70c12060e5503205a787a2e43c005a5d07a25ecee3d03c3ece562a53.png?name=Screenshot_2025-02-22_at_11.12.08_AM.png"},"domain":null,"followersCount":2,"id":"41318","membersCount":3,"name":"CT 50501","physicalAddress":{"__typename":"Address","country":"United States","description":"Connecticut","geom":"-72.7342163;41.6500201","id":"613","locality":null,"originId":null,"pictureInfo":null,"postalCode":null,"region":null,"street":null,"timezone":"America/New_York","type":null,"url":"https://events.pol-rev.com/address/d5446a85-96a7-4d92-a731-b0bd86aa025b"},"preferredUsername":"ct_50501","summary":"<p>50 protests. 50 states. 1 movement.</p><p>Join us in the fight to uphold the Constitution and end executive overreach.</p>","type":"GROUP","url":"https://events.pol-rev.com/@ct_50501"},{"__typename":"Group","avatar":{"__typename":"Media","id":"64bad8ae-867c-492c-9df2-61a333ff3344","url":"https://events.pol-rev.com/media/4d76c9a4bd7335565ab1c8de248a7a2eda4ff1c8d4933e1bc6f54c354bb19da5.jpg?name=FiFA.jpg"},"banner":{"__typename":"Media","id":"8311b495-ef72-4046-9e98-3e471fbade03","url":"https://events.pol-rev.com/media/80e5f62eda5ccaaf9bad2c1614b1ed5b96e64f0be92d07bbec3f4d13130008fc.jpg?name=first_in_freedom_again%27s%20banner.jpg"},"domain":null,"followersCount":2,"id":"35679","membersCount":1,"name":"First in Freedom Again","physicalAddress":{"__typename":"Address","country":"United States","description":"Charlotte","geom":"-80.8226636;35.2412292","id":"549","locality":"Charlotte","originId":null,"pictureInfo":null,"postalCode":"28206","region":"North Carolina","street":"North Tryon Street","timezone":"America/New_York","type":null,"url":"https://events.pol-rev.com/address/a9261ea6-d955-4b97-bc20-271a93d36696"},"preferredUsername":"first_in_freedom_again","summary":"<p>On May 20th 1775 it is said Mecklenburg County in NC was the first in the nation to declare its independence from Great Britain. On May 20th 2025 it will be 250 yrs since that document and patriots from the Mecklenburg area must rise up again and decry the Trump &amp; MAGA agenda to make us a &quot;colony&quot; of Russia. This is a group that welcomes folks of all political agendas; however, we are not about discussing those agendas but instead seek to galvanize around our common ground to protect our country from extremist forces on both sides of the aisle bent on tearing us apart. We believe that we need to begin the process of showing our country and politicians that what is happening in Washington is unacceptable and it is time to act.</p>","type":"GROUP","url":"https://events.pol-rev.com/@first_in_freedom_again"},{"__typename":"Group","avatar":null,"banner":null,"domain":null,"followersCount":0,"id":"35385","membersCount":1,"name":"Middle Tennesseans For Democracy ","physicalAddress":{"__typename":"Address","country":"United States","description":"Murfreesboro","geom":"-86.3921096;35.8460396","id":"539","locality":null,"originId":null,"pictureInfo":null,"postalCode":null,"region":"Tennessee","street":null,"timezone":"America/Chicago","type":null,"url":"https://events.pol-rev.com/address/bad70fa6-2a4f-40df-9b28-02ba44e2e2d2"},"preferredUsername":"middle_tennesseans_for_democracy_","summary":"<p>A grassroots group of middle Tennesseans  who want to protest locally and stand up for democracy. </p>","type":"GROUP","url":"https://events.pol-rev.com/@middle_tennesseans_for_democracy_"},{"__typename":"Group","avatar":{"__typename":"Media","id":"0b1a465b-0bc7-49c5-982f-03fd66abbe2c","url":"https://events.pol-rev.com/media/2a738323d6be7e365d171fc07c11cda776f7322b36b78835aec9f578d6fc5b49.jpg?name=ETAlliance.jpg"},"banner":null,"domain":null,"followersCount":0,"id":"34676","membersCount":1,"name":"etalliance","physicalAddress":{"__typename":"Address","country":"United States","description":"Longview","geom":"-94.74049;32.5007031","id":"536","locality":null,"originId":null,"pictureInfo":null,"postalCode":null,"region":"Texas","street":null,"timezone"