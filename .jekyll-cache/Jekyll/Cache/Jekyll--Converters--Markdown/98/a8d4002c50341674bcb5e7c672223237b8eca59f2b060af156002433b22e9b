<!-- Provider SDKs (loaded once, guarded) -->
<script>
  // Instagram
  (function loadIG(){
    if (window.__IG_EMBED_LOADED__) return;
    window.__IG_EMBED_LOADED__ = true;
    var s=document.createElement('script');
    s.src='https://www.instagram.com/embed.js'; s.async=true; s.defer=true;
    document.head.appendChild(s);
  })();
  // Facebook
  (function loadFB(){
    if (window.__FB_SDK_LOADED__) return;
    window.__FB_SDK_LOADED__ = true;
    var d=document, s=d.createElement('script'); s.async=true; s.defer=true;
    s.crossOrigin='anonymous';
    s.src='https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v20.0';
    if (!d.getElementById('fb-root')) {
      var fr=d.createElement('div'); fr.id='fb-root'; d.body.appendChild(fr);
    }
    document.head.appendChild(s);
  })();
</script>

